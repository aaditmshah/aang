{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "import", "jsdoc", "oxc", "promise", "typescript", "unicorn", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"rules": {
		"@typescript-eslint/unbound-method": ["error", { "ignoreStatic": true }]
	},
	"env": {
		"builtin": true
	}
}
